{
  "analysis": "Qwen pre-pivot text and metadata baselines",
  "positive_class": "correction",
  "text_scope": "Generated text occurring before the detected pivot phrase",
  "models": {
    "metadata_basic": {
      "categorical": [
        "category",
        "pivot_type",
        "pivot_phrase"
      ],
      "numeric": [
        "pre_pivot_tokens",
        "total_tokens",
        "pivot_fraction",
        "pre_pivot_characters",
        "pre_pivot_words"
      ],
      "includes_prompt_id": false
    },
    "metadata_plus_prompt_id": {
      "categorical": [
        "category",
        "pivot_type",
        "pivot_phrase",
        "prompt_id"
      ],
      "numeric": [
        "pre_pivot_tokens",
        "total_tokens",
        "pivot_fraction",
        "pre_pivot_characters",
        "pre_pivot_words"
      ],
      "includes_prompt_id": true,
      "purpose": "Explicit prompt-identity leakage diagnostic"
    },
    "text_tfidf": {
      "ngram_range": [
        1,
        2
      ],
      "min_df": 2,
      "max_features": 5000
    },
    "text_plus_metadata": {
      "text": "Same TF-IDF configuration",
      "categorical": [
        "category",
        "pivot_type",
        "pivot_phrase"
      ],
      "numeric": [
        "pre_pivot_tokens",
        "total_tokens",
        "pivot_fraction",
        "pre_pivot_characters",
        "pre_pivot_words"
      ],
      "includes_prompt_id": false
    }
  },
  "classifier": {
    "model": "LogisticRegression",
    "class_weight": "balanced",
    "C": 0.01,
    "max_iter": 3000,
    "random_state": 42,
    "hyperparameter_tuning": false
  },
  "cv_split_seed": 42,
